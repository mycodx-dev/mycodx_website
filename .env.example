# Enable only after configuring and verifying a test deployment.
MAIL_FORMS_ENABLED=false
FORM_ALLOWED_ORIGINS=https://mycodx.com,https://www.mycodx.com
# Generate distinct secrets: openssl rand -hex 32
FORM_SIGNING_SECRET=
CRON_SECRET=

# Connect a PRIVATE Vercel Blob store to this project/environment.
BLOB_READ_WRITE_TOKEN=

# Resend sending-only API key. Verify send.mycodx.com in Resend before enabling.
RESEND_API_KEY=
MAIL_FROM=website@send.mycodx.com
CONTACT_TO=info@mycodx.com
CAREERS_TO=jakim@mycodx.com

# Set to your own mailbox for Preview testing; leave blank in Production.
MAIL_TEST_RECIPIENT=
