# Enable only after configuring and verifying a test deployment.
MAIL_FORMS_ENABLED=false
# Careers DB receipt is enabled independently of notification mail.
# Keep false until the applied SQL, private bucket, and test environment are verified.
RECRUIT_FORMS_ENABLED=false
SUPABASE_URL=
# Modern sb_secret_... key, SERVER ONLY. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
# Already registered; reserved for the subsequent administrator Auth implementation.
SUPABASE_PUBLISHABLE_KEY=
# Choose exactly one: smtp or resend. Empty/invalid means disabled; no automatic fallback.
MAIL_PROVIDER=
FORM_ALLOWED_ORIGINS=https://mycodx.com,https://www.mycodx.com,https://mycodx-website.vercel.app,https://mycodx-website-myco-dx.vercel.app,https://mycodx-website-git-main-myco-dx.vercel.app
# Generate distinct secrets: openssl rand -hex 32
FORM_SIGNING_SECRET=
CRON_SECRET=

# Connect a PRIVATE Vercel Blob store to this project/environment.
BLOB_READ_WRITE_TOKEN=

# Option A: existing ECOUNT mailbox. Sender is always SMTP_USER.
# Confirm server settings in the mailbox's external integration guide.
SMTP_HOST=wsmtp.ecount.com
SMTP_PORT=587
SMTP_USER=info@mycodx.com
# Register in Vercel as Secret. Never commit the real password.
SMTP_PASS=

# Option B: Resend. Only required when MAIL_PROVIDER=resend.
# Verify send.mycodx.com before enabling; this is separate from website DNS migration.
RESEND_API_KEY=
RESEND_FROM=website@send.mycodx.com

# Both providers use these recipients; Preview always requires a test mailbox.
CONTACT_TO=info@mycodx.com
CAREERS_TO=jakim@mycodx.com

# Set for ALL test deployments, including a Production deployment on vercel.app.
# Remove only when intentionally opening real applications after verification.
MAIL_TEST_RECIPIENT=
