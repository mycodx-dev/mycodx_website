{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "fluid": true,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "functions": {
    "api/forms.ts": {
      "maxDuration": 180
    }
  },
  "crons": [
    { "path": "/api/forms?action=cleanup", "schedule": "0 18 * * *" }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
